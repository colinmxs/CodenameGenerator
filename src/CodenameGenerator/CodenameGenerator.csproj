<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Version here is the local/default value. CI passes -p:Version=<prefix>.<run>
    on the command line, so nothing rewrites this file during a build.
    AssemblyVersion stays pinned to the major release so per-build numbers can't
    break assembly binding for consumers; CI passes a matching FileVersion, and
    InformationalVersion carries the full package version either way.
  -->
  <PropertyGroup>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>

    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>

    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <PackageId>CodenameGenerator</PackageId>
    <Authors>Colin Smith</Authors>
    <Company />
    <Copyright>2017 Colin Smith</Copyright>
    <PackageTags>codenamegenerator codename code name generator random word</PackageTags>
    <PackageProjectUrl>https://github.com/colinmxs/CodenameGenerator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/colinmxs/CodenameGenerator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>Codename generator for .NET. Generates random codenames/usernames from bundled word lists.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReleaseNotes>
+ Word lists moved from compiled arrays into embedded resources and loaded lazily: much smaller assembly, and only the banks you use are read into memory.
+ Unseeded generators are now thread-safe.
+ Casing is applied with invariant culture, so output no longer varies by locale.
+ GenerateUnique() is now bounded and throws instead of recursing without limit.
+ Generate() no longer throws when Parts is empty; added a clear error for an empty WordBank.
+ Added WordBank.All. Fixed the Months word list, which was missing April.
- Breaking: dropped net452, netstandard1.0 and netstandard1.3. Targets netstandard2.0 (.NET Framework 4.6.1+) and net8.0.
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <!-- The word lists ship as resources rather than compiled string arrays. -->
    <EmbeddedResource Include="WordData\*.txt" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
